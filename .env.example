# Copy to .env (gitignored) and fill in. EVAC-120 runs on a site edge node and
# must work with zero Internet: nothing here may point at a cloud service that
# the accountability path depends on.

# --- Identity of this deployment ---
EVAC_SITE_ID=                  # REQUIRED (uuid) — the building this node covers
EVAC_TENANT_ID=                # REQUIRED (uuid)
# NOT READ by any code yet. Which half a node is shows in what is configured
# -- a node with EVAC_CENTRAL_URL set replicates and one without it does not --
# so nothing has needed to ask. Kept because a deployment describes itself
# here, and marked so it is not mistaken for a switch.
EVAC_NODE_ROLE=edge            # edge | central

# --- Own Postgres (firedrill owns its schema; it does not share VisionTrack's) ---
EVAC_DB_HOST=localhost
EVAC_DB_PORT=5432
EVAC_DB_NAME=firedrill
EVAC_DB_USER=firedrill
EVAC_DB_PASSWORD=              # REQUIRED — no default, never hard-coded

# --- Redis: the event bus firedrill consumes from ---
# Produced by the DeepStream pipeline (Phase 2) and VisionTrack's workers.
EVAC_REDIS_URL=redis://localhost:6379/0
EVAC_EVENT_STREAM_PREFIX=vt:evac:events    # actual key is <prefix>:<tenant_id>

# The two below are NOT READ by any code yet. VisionTrack publishes raw tracks
# and lifecycle on them, and the design has firedrill consuming only the
# evacuation stream above, which the DeepStream pipeline populates. Listed so
# the intent is on record; a variable a reader sets and nothing reads is worse
# than one that is absent, so this says which it is.
EVAC_TRACK_STREAM=vt:tracks
EVAC_TRACK_LIFECYCLE_STREAM=vt:track_lifecycle

# --- The roster: "who is expected" ---
# This is the one setting a drill cannot be created without. An empty roster
# produces a board reading "0 of 0 accounted", which looks like success and is
# the most dangerous screen this system can show, so a missing roster refuses
# the drill instead.
EVAC_ROSTER_FILE=              # REQUIRED — a FaceTrack roster export (JSON)

# The three below are NOT READ by any code yet: the FaceTrack HTTP client is a
# Phase 5 item and the roster comes from the export above. Listed so the intent
# is on record, and marked so nobody configures a node from this file and finds
# out at the first drill.
#
# `EVAC_FACETRACK_URL` used to be enough to satisfy the roster check at
# startup, so a node filled in from this template reported no roster problem
# and then refused to create a drill. The startup check now asks for
# EVAC_ROSTER_FILE and says so by name.
EVAC_FACETRACK_URL=http://localhost:5002
EVAC_FACETRACK_API_KEY=        # for the Phase 5 client
EVAC_FACETRACK_COMPANY_ID=     # for the Phase 5 client (uuid)

# --- Store-and-forward outbox (edge -> central replication) ---
# Same pattern as DeepStream's utils/outbox.py, vendored in app/vendor/deepstream.
EVAC_OUTBOX_DIR=./outbox
EVAC_OUTBOX_FLUSH_SEC=15

# --- Central replica (edge nodes only; unset on the central node itself) ---
EVAC_CENTRAL_URL=
EVAC_CENTRAL_TOKEN=            # REQUIRED when EVAC_CENTRAL_URL is set

# --- Auth ---
EVAC_JWT_SECRET=               # REQUIRED unless identity headers are trusted
EVAC_JWT_ALGORITHM=HS256       # HMAC only; RS256 and alg:none are refused
EVAC_JWT_ISSUER=               # optional, checked when set
EVAC_JWT_AUDIENCE=             # optional, checked when set
EVAC_JWT_LEEWAY_S=30
# NOT READ by any code yet: tokens are issued elsewhere and this service only
# verifies them, so the lifetime is the issuer's to set. Kept as the figure a
# site should issue against -- a warden carries one device through a whole
# drill day -- and marked so nobody expects this file to enforce it.
EVAC_JWT_TTL_MIN=720           # wardens carry a device through a whole drill day

# Only when a gateway in front of this service has already authenticated the
# caller. Off by default: a service that trusts X-Permissions from anyone who
# can reach it has no authentication at all. With this off and no secret set,
# every request is refused and /healthz reports the gap.
EVAC_TRUST_IDENTITY_HEADERS=false

# --- Durable storage ---
EVAC_DATABASE_URL=             # or the EVAC_DB_* parts below
EVAC_GEOMETRY_FILE=            # a VisionTrack geometry export, the offline path
EVAC_VISIONTRACK_DSN=          # read-only; used when no export is configured
EVAC_ZONE_KINDS=               # zone_id=KIND pairs; there is no safe default

# Which zones are muster points. Read by the API to decide whether a warden
# standing somewhere is standing at an assembly point, which is half of what
# ACCOUNTED requires -- so a drill with this unset can account for nobody
# through the cameras.
EVAC_ASSEMBLY_ZONES=           # comma-separated zone ids

# --- Ingest tuning (optional; the defaults are the documented ones) ---
EVAC_CONSUMER_NAME=            # defaults to edge-<site_id>; set when two
                               # processes read one stream
